# Huawei App Service references classes that exist only on Huawei devices or
# in optional SDKs. Its own keep rules do not suppress these warnings.
-dontwarn com.huawei.android.**
-dontwarn com.huawei.appgallery.log.**
-dontwarn com.huawei.hianalytics.**
-dontwarn com.huawei.libcore.io.**
-dontwarn com.huawei.ohos.localability.**
-dontwarn com.huawei.system.**
-dontwarn org.bouncycastle.crypto.**
