{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dart:pub:get",
      "type": "shell",
      "command": [
        "mise exec -- just get"
      ],
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "dart:format",
      "type": "shell",
      "command": [
        "mise exec -- just format"
      ],
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "dart:build_runner:dir",
      "type": "shell",
      "command": [
        "mise exec -- dart run build_runner build --build-filter '${fileDirname}/*.dart'"
      ],
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "dart:pub:get"
      ]
    },{
      "label": "example:dart:build_runner:dir",
      "type": "shell",
      "command": [
        "mise exec -- dart run build_runner build --build-filter '${fileDirname}/*.dart'",
        "&& mise exec -- dart format -l 80 '${fileDirname}'"
      ],
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "dart:pub:get"
      ]
    },
    {
      "label": "clear:example:build",
      "type": "shell",
      "command": "mise exec -- just clean",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Remove-Item -Path '${workspaceFolder}\\example\\build' -Recurse -Force -ErrorAction Ignore"
        ]
      },
      "linux": {
        "command": "rm -rf",
        "args": [
          "${workspaceFolder}/example/build"
        ]
      },
      "osx": {
        "command": "rm -rf",
        "args": [
          "${workspaceFolder}/example/build"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "dart:build_runner:test_dir",
      "type": "shell",
      "command": [
        "mise exec -- dart run build_runner build --build-filter 'test/**'"
      ],
      "group": {
        "kind": "none",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "dart:pub:get"
      ]
    },
    {
      "label": "init:ios:pods",
      "type": "shell",
      "command": [
        "mise exec -- just init-ios-pods"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "init:ios:spm",
      "type": "shell",
      "command": [
        "mise exec -- just init-ios-spm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
